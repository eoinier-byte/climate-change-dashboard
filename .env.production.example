# Production settings (CCD-251 Configure environment variables).
# On the server: copy to .env, fill in real values, and never commit it.
# Make long random passwords and keys with:  openssl rand -base64 32

# The site's address (no https://), used by Caddy for the HTTPS certificate
DOMAIN=example.me

# Database
DB_NAME=climate
DB_OWNER=climate_owner          # owns the tables, used only for migrations
DB_OWNER_PASSWORD=change-me
APP_DB_USER=climate_app         # the limited user Django connects as
APP_DB_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
CORS_ALLOWED_ORIGINS=https://example.me
# Address put in the links of account emails
DOMAIN_NAME=https://example.me

# Email (account emails). Needed when DJANGO_DEBUG=False.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# AI assistant (optional; leave empty to run without it)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5