# Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_DB=ccd
POSTGRES_USER=ccd
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Sprint 3) - use a test/sandbox provider
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AI commentary (Sprint 4, optional)
AI_API_KEY=
