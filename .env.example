# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by Django, db/check_connection.py and docker-compose)
# docker-compose creates the database and user from DB_NAME / DB_USER / DB_PASSWORD
# on the first start. DB_PORT is the host port the container is published on.
DB_NAME=climate
DB_USER=climate_admin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis cache (docker-compose publishes it on REDIS_PORT). Optional: if Redis is down,
# the API still works and reads straight from the database.
REDIS_HOST=localhost
REDIS_PORT=6379

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Sprint 3) - use a test/sandbox provider
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AI assistant and commentary (optional): Anthropic API key from console.anthropic.com
# Leave empty to run without the AI features.
ANTHROPIC_API_KEY=
