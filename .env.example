# Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_DB=ccd
POSTGRES_USER=ccd
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App database connection (used by Django and db/check_connection.py)
# Two sets of credentials on purpose:
#   POSTGRES_* = the container admin. Read by docker-compose (and CI) to create the
#                server; only used to run db/create_dev.sql and db/create_staging.sql.
#   DB_*       = the app user. Least privilege, can reach only its own database.
#                For staging, change DB_NAME, DB_USER and DB_PASSWORD only.
# DB_PORT must match POSTGRES_PORT. DB_PASSWORD is the one you gave create_dev.sql.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=climate_dev
DB_USER=climate_app
DB_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Sprint 3) - use a test/sandbox provider
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AI commentary (Sprint 4, optional)
AI_API_KEY=
