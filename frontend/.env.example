# Copy to .env and adjust. Never commit .env.
VITE_API_URL=http://localhost:8000/api

# Use example data from src/mocks instead of the real API (see docs/api-examples.md).
# Set to true when a backend endpoint is not ready yet. Keep false otherwise.
VITE_USE_MOCKS=false

# Optional: pretend the mock API is slow (milliseconds) to see loading states.
# VITE_MOCK_DELAY_MS=800
